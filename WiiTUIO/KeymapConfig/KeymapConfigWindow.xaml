<Controls:MetroWindow
  x:Class="WiiTUIO.KeymapConfigWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  Title="Controller Configuration" ResizeMode="CanResize" MinHeight="200" MinWidth="920" MaxWidth="920" Height="600" Closed="MetroWindow_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                <ResourceDictionary Source="/Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Controls:MetroWindow.LeftWindowCommands>
        <Controls:WindowCommands>

        </Controls:WindowCommands>
    </Controls:MetroWindow.LeftWindowCommands>
    <StackPanel Name="mainPanel" Orientation="Horizontal">
        <DockPanel Width="240">
            <Label FontFamily="Segoe UI Light" FontSize="18" Padding="10" DockPanel.Dock="Top">Layouts</Label>
            <ScrollViewer>
                <StackPanel>
                    <StackPanel Name="spLayoutList">
                    </StackPanel>
                    <Grid>
                        <Border Name="bAddKeymap" MouseUp="bAddKeymap_MouseUp" Cursor="Hand" Width="180" Background="{DynamicResource MahApps.Brushes.Button.Flat.Background}" BorderThickness="0" BorderBrush="#FF2E2E2E" Margin="5" CornerRadius="2">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Foreground="#FF2E2E2E" Margin="5" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <DockPanel Width="420">
            <Label FontFamily="Segoe UI Light" FontSize="18" Padding="10" DockPanel.Dock="Top">Edit Layout</Label>
            <ScrollViewer PanningMode="VerticalOnly">
                <StackPanel>
                    <StackPanel Margin="4,0">
                        <Grid>
                            <TextBox HorizontalAlignment="Left" Name="tbKeymapTitle" Tag="Title" FontFamily="Segoe UI Semilight" FontSize="14" Padding="2,1" Margin="6" Width="223"></TextBox>
                            <TextBlock Name="tbDelete" Cursor="Hand" MouseUp="tbDelete_MouseUp" Foreground="Red" FontFamily="Segoe UI Semilight" FontSize="12" Margin="349,10,6,10" TextAlignment="Center" TextDecorations="Underline">Delete</TextBlock>
                        </Grid>
                        <CheckBox Name="cbLayoutChooser" FontFamily="Segoe UI Semilight" Margin="6">Available in Layout Chooser (hold Home 3 sec)</CheckBox>
                        <DockPanel VerticalAlignment="Top">
                            <CheckBox Name="cbApplicationSearch" FontFamily="Segoe UI Semilight" Margin="6,6,6,6">Hook to application</CheckBox>

                            <ItemsControl x:Name="hookAppItemsControl" ItemsSource="{Binding SearchStrings}" IsEnabled="{Binding IsChecked, ElementName=cbApplicationSearch}" DockPanel.Dock="Left" Margin="8,0,20,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button Cursor="Hand" Width="16" Height="16" Tag="{Binding}" Click="RemoveHookAppEntry" Style="{x:Null}" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
                                                <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="{DynamicResource MahApps.Brushes.Gray3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <Button Cursor="Hand" Width="16" Height="16" Tag="{Binding}" Click="AddHookAppEntry" Style="{x:Null}" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
                                                <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource MahApps.Brushes.Gray3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <TextBox Text="{Binding SearchString,UpdateSourceTrigger=PropertyChanged}" FontFamily="Segoe UI Semilight" FontSize="12" Margin="6,6,6,6"
                                                Tag="{Binding}" LostFocus="HookApp_TextBox_LostFocus" KeyUp="HookApp_TextBox_KeyUp">
                                            </TextBox>
                                        </DockPanel>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </StackPanel>
                    <Border BorderBrush="#FFCBCBCB" BorderThickness="0,0,0,1" Margin="6"></Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label FontFamily="Segoe UI Semilight" FontSize="13" Margin="2,2,2,2">Controllers</Label>
                        <Border Name="btnAllBorder" Background="#FF2E2E2E" CornerRadius="4" Margin="2,3">
                            <Button Cursor="Hand" Name="btnAll" Click="btnAll_Click" Background="{x:Null}" Foreground="White" Padding="4,0" Height="27">All</Button>
                        </Border>
                        <Border Name="btn1Border" Background="#FF2E2E2E" CornerRadius="4" Margin="2,3">
                            <Button Cursor="Hand" Name="btn1" Click="btn1_Click" Background="{x:Null}" Foreground="White" Padding="6,0" Height="27">1</Button>
                        </Border>
                        <Border Name="btn2Border" Background="#FF2E2E2E" CornerRadius="4" Margin="2,3">
                            <Button Cursor="Hand" Name="btn2" Click="btn2_Click" Background="{x:Null}" Foreground="White" Padding="6,0" Height="27">2</Button>
                        </Border>
                        <Border Name="btn3Border" Background="#FF2E2E2E" CornerRadius="4" Margin="2,3">
                            <Button Cursor="Hand" Name="btn3" Click="btn3_Click" Background="{x:Null}" Foreground="White" Padding="6,0" Height="27">3</Button>
                        </Border>
                        <Border Name="btn4Border" Background="#FF2E2E2E" CornerRadius="4" Margin="2,3">
                            <Button Cursor="Hand" Name="btn4" Click="btn4_Click" Background="{x:Null}" Foreground="White" Padding="6,0" Height="27">4</Button>
                        </Border>
                        <Border Name="rad1Border" CornerRadius="2" Margin="20,2,2,2">
                            <RadioButton Name="rbOnscreen" FontFamily="Segoe UI Semilight" Background="{x:Null}" Margin="2">On Screen</RadioButton>
                        </Border>
                        <Border Name="rad2Border" CornerRadius="2" Margin="2">
                            <RadioButton Name="rbOffscreen" FontFamily="Segoe UI Semilight" Background="{x:Null}" Margin="2">Off Screen</RadioButton>
                        </Border>
                    </StackPanel>
                    <Label FontFamily="Segoe UI Light" FontSize="18" Padding="10">Wiimote</Label>
                    <StackPanel Name="spWiimoteConnections">
                    </StackPanel>
                    <Label FontFamily="Segoe UI Light" FontSize="18" Padding="10">Nunchuk</Label>
                    <StackPanel Name="spNunchukConnections">
                    </StackPanel>
                    <Label FontFamily="Segoe UI Light" FontSize="18" Padding="10">Classic Controller</Label>
                    <StackPanel Name="spClassicConnections">
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <DockPanel Width="240">
            <Label FontFamily="Segoe UI Light" FontSize="18" Padding="10" Content="Outputs" DockPanel.Dock="Top"/>
            <StackPanel DockPanel.Dock="Top" Margin="10,0">
                <ComboBox SelectionChanged="cbOutput_SelectionChanged" x:Name="cbOutput" FontFamily="Segoe UI Semilight" FontSize="14" Padding="5">
                    <ComboBoxItem IsSelected="True" x:Name="cbiAll" Content="All"/>
                    <ComboBoxItem x:Name="cbiKeyboard" Content="Keyboard"/>
                    <ComboBoxItem x:Name="cbiMouse" Content="Mouse"/>
                    <ComboBoxItem x:Name="cbi360" Content="360 Controller"/>
                    <ComboBoxItem x:Name="cbiWiimote" Content="Wiimote"/>
                    <ComboBoxItem x:Name="cbiCursor" Content="Cursor"/>
                    <ComboBoxItem x:Name="cbiOther" Content="Other"/>
                </ComboBox>
                <TextBox x:Name="tbOutputFilter" GotFocus="tb_placeholder_GotFocus" LostFocus="tb_placeholder_LostFocus" TextChanged="tbOutputFilter_TextChanged" Tag="Filter" FontFamily="Segoe UI Semilight" FontSize="14" Padding="2,1" Margin="0,8,0,0"/>
            </StackPanel>
            <ScrollViewer PanningMode="VerticalOnly">
                <StackPanel Name="spOutputList" Margin="0,10" Width="240">
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </StackPanel>
</Controls:MetroWindow>
