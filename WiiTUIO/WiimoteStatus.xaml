<StackPanel Width="429" Background="#FF2F2F2F" x:Class="WiiTUIO.WiimoteStatusUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d">
    <Canvas Height="63">
        <Grid Canvas.Left="15" Canvas.Top="18">
            <Button Name="colorBtn" Width="25" Height="25" Click="popClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Canvas>
                            <Ellipse Opacity="0.6" Width="25" Height="25" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
                            <Ellipse Opacity="0.4" Width="19" Height="19" Canvas.Left="3" Canvas.Top="3" Fill="White" StrokeThickness="2"/>
                        </Canvas>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Popup Name="colorPopup" PlacementTarget="{Binding ElementName=colorBtn}" StaysOpen="False" PopupAnimation="Fade" Closed="popClosed">
                <Border Background="{DynamicResource MahApps.Brushes.Window.Background}" BorderThickness="1" CornerRadius="8" Padding="10" Width="480" Height="320" BorderBrush="{DynamicResource MahApps.Brushes.Accent}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Set player color" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource MahApps.Brushes.WindowTitle}"/>
                        <mah:ColorCanvas Name="picker"
                             IsAlphaChannelVisible="False"
                             Margin="0,0,0,10"/>
                        <Button Content="Save" Click="svClick" HorizontalAlignment="Center" Width="120" Style="{DynamicResource MahApps.Styles.Button}" Command="{Binding SaveColorCommand}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        <TextBlock Name="lbId" Text="2" Width="30" Height="24" Canvas.Left="41" Canvas.Top="20" FontFamily="Segoe UI Semilight" FontSize="14" Foreground="White" TextAlignment="Center"/>
        <Label Name="lbStatus" Content="connected" Canvas.Left="108" Canvas.Top="14" FontFamily="Segoe UI Light" FontSize="15" Foreground="#FF5BFF00"/>
        <Label Content="battery:" Canvas.Left="288" Canvas.Top="14" FontFamily="Segoe UI Light" FontSize="15" Foreground="White"/>
        <Rectangle Name="battery1" Fill="White" Height="20" Width="7" Canvas.Left="349" Canvas.Top="20"/>
        <Rectangle Name="battery2" Fill="White" Height="20" Width="7" Canvas.Left="358" Canvas.Top="20"/>
        <Rectangle Name="battery3" Fill="White" Height="20" Width="7" Canvas.Left="367" Canvas.Top="20"/>
        <Rectangle Name="battery4" Fill="White" Height="20" Width="7" Canvas.Left="376" Canvas.Top="20"/>
        <Rectangle Name="battery5" Fill="White" Height="20" Width="7" Canvas.Left="385" Canvas.Top="20"/>
        <Rectangle Name="battery6" Fill="#FF4F4F4F" Height="20" Width="7" Canvas.Left="394" Canvas.Top="20"/>
        <Rectangle Width="429" Fill="#FF191919" Height="3" Canvas.Bottom="0"/>
    </Canvas>
</StackPanel>
